# Credenciales de acceso al panel
AUTH_LOGIN_EMAIL=admin@chequeria.app
AUTH_LOGIN_PASSWORD=cambiar_esto

# JWT - generá un string largo y aleatorio
AUTH_JWT_SECRET=cambiar_esto_por_un_secreto_largo_y_aleatorio
AUTH_COOKIE_NAME=chequeria_session
AUTH_JWT_EXPIRES_IN=12h

# Anthropic (Claude) - necesario para leer CUILs desde fotos
# Obtené tu clave en https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Opcional: label que aparece en el header del dashboard
NEXT_PUBLIC_USER_EMAIL=admin@chequeria.app
